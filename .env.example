# Скопируйте в .env и поменяйте значения. Файл .env не попадает в git.

ENVIRONMENT=local
# Только для сервера: домен, на который Caddy получит HTTPS-сертификат.
API_DOMAIN=vezzi.vps.webdock.cloud
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Для запуска uvicorn с Mac. Внутри Docker адрес подставляется из compose.yaml.
DATABASE_URL=postgresql+psycopg://vezzi:vezzi@localhost:5432/vezzi
POSTGRES_DB=vezzi
POSTGRES_USER=vezzi
POSTGRES_PASSWORD=vezzi

# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-env-file-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10

# Цены старше этого возраста не участвуют в расчёте. В ТЗ 6 ч, утверждено 24 ч.
OFFER_MAX_AGE_HOURS=24
CATALOG_TIMEZONE=Europe/Moscow

# osrm: свой маршрутизатор (docs/routing.md).
# fake: оценка по прямой, только для разработки и тестов.
ROUTING_PROVIDER=fake
OSRM_BASE_URL=http://localhost:5001
ROUTING_TIMEOUT_SECONDS=10

PLANNER_CANDIDATE_STORES=8
SHOPPING_MIN_VISIT_SECONDS=600
SHOPPING_BASE_SECONDS=300
SHOPPING_SECONDS_PER_POSITION=60
SHOPPING_SECONDS_PER_UNIT=5
